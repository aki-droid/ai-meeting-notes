generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  meetings     Meeting[]
}

model Meeting {
  id          Int          @id @default(autoincrement())
  userId      Int
  title       String
  audioUrl    String
  summary     String?
  status      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcripts Transcript[]
  todos       Todo[]

  @@index([userId])
}

model Transcript {
  id        Int      @id @default(autoincrement())
  meetingId Int
  speaker   String
  startTime Float
  endTime   Float
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model Todo {
  id        Int      @id @default(autoincrement())
  meetingId Int
  content   String
  assignee  String?
  dueDate   DateTime?
  completed Boolean  @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
